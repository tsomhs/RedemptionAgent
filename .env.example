# Settings of the redemptions agent. Copy to .env and fill in.
# A different file can be used per run:  python main.py --env .env.other <command>
# Real environment variables override whatever is written here.

# test: the agent refuses to send anywhere outside ALLOWED_RECIPIENTS.
# live: it sends to the partners' real addresses.
MAIL_MODE=test

# Database file, relative to the project folder. data/demo.db is special: if it
# does not exist it is created with invented data, to look around the dashboard.
# For real work use another name, e.g. data/agent.db.
AGENT_DB=data/demo.db

# --- Mailbox the agent sends from and reads replies in ----------------------
# The values below are the ones Gmail uses.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# none | starttls | ssl
SMTP_SECURITY=starttls
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# none | ssl
IMAP_SECURITY=ssl
MAIL_USER=
# For Gmail: an app password, not the account password.
MAIL_PASSWORD=
MAIL_FROM=

# Test mode only: addresses or @domains that may receive mail. Plus-aliases of
# a listed address pass (name+partner@gmail.com), so one inbox can play every
# partner. Empty blocks everything.
ALLOWED_RECIPIENTS=

# Test mode only: a second mailbox that plays the partner, for simulate-reply.
TEST_PARTNER_USER=
TEST_PARTNER_PASSWORD=

# --- Reminders ---------------------------------------------------------------
FOLLOWUP_DAYS=7
MAX_FOLLOWUPS=3

# --- Reading free-text replies with an AI model (optional) ------------------
# Replies in the agreed format ("[code] offer: 12") never need it. Without a
# key, anything else waits in the review queue. Claude is used when its key is
# set, otherwise Gemini.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
